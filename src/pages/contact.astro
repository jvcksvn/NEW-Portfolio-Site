---
/*
  /contact. Copy, field labels, placeholders, submit label, success state and
  both error states are all written in 04 and used verbatim.

  Posted by fetch to Formspree so the states render inline with no redirect to a
  third party page. A honeypot field catches spam. The email address and the
  LinkedIn link sit below the form as plain fallbacks, because a form that fails
  without an alternative loses the message.

  Labels are nouns above the field, always visible. Nothing is marked required,
  because required is the default a visitor assumes and nothing here is optional.
  The submit button is the only filled element on the site.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, FORMSPREE_FORM_ID } from '../data/copy/contact';
import { titleFor } from '../lib/seo';
import { ROUTES } from '../lib/routes';

const endpoint = FORMSPREE_FORM_ID ? `https://formspree.io/f/${FORMSPREE_FORM_ID}` : '';
---

<BaseLayout title={titleFor(ROUTES.contact.label)} description={CONTACT.meta}>
  <section class="shell contact-page">
    <h1 class="t-display">{CONTACT.h1}</h1>
    <p class="t-lede body reading">{CONTACT.body}</p>

    <form class="contact-form" data-contact data-endpoint={endpoint} novalidate>
      {
        CONTACT.fields.map((field) => (
          <div class="field">
            <label class="t-label" for={field.name}>
              {field.label}
            </label>

            {field.type === 'textarea' ? (
              <textarea
                id={field.name}
                name={field.name}
                rows="6"
                placeholder={field.placeholder}
                aria-describedby={`${field.name}-error`}
              />
            ) : (
              <input
                id={field.name}
                name={field.name}
                type={field.type}
                placeholder={field.placeholder}
                aria-describedby={`${field.name}-error`}
              />
            )}

            <p class="error t-small" id={`${field.name}-error`} data-error={field.name} hidden></p>
          </div>
        ))
      }

      {/* Honeypot. Hidden from people, harvested by bots. */}
      <div class="honeypot" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {/*
        The send button and the direct routes sit on one row. The fallbacks
        used to sit in a block below the form, which read as a footnote to a
        form that might not work. Beside the button they read as the second and
        third way to do the same thing, which is what they are.
      */}
      <div class="send-row">
        <button class="submit" type="submit">{CONTACT.submit}</button>

        <p class="or t-label" id="or-directly">Or directly</p>

        <ul class="fallbacks" aria-labelledby="or-directly">
          {
            CONTACT.fallbacks.map((f) => (
              <li>
                <a
                  class="fallback t-small"
                  href={f.href}
                  rel={f.href.startsWith('http') ? 'me noopener' : undefined}
                >
                  {f.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="form-status t-small" data-status role="status" aria-live="polite" hidden></p>
    </form>
  </section>
</BaseLayout>

<script>
  import { CONTACT } from '../data/copy/contact';

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const status = document.querySelector<HTMLElement>('[data-status]');

  if (form && status) {
    const errorFor = (name: string) =>
      form.querySelector<HTMLElement>(`[data-error="${name}"]`);

    const setError = (name: string, message: string | null) => {
      const node = errorFor(name);
      const field = form.querySelector<HTMLElement>(`#${name}`);
      if (!node) return;
      node.textContent = message ?? '';
      node.hidden = !message;
      field?.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const showStatus = (message: string, kind: 'ok' | 'fail') => {
      status.textContent = message;
      status.hidden = false;
      status.dataset.kind = kind;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.hidden = true;

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();

      /* Problem first, then the fix. 04 writes both of these. */
      let valid = true;

      if (!email.includes('@')) {
        setError('email', CONTACT.errors.email);
        valid = false;
      } else {
        setError('email', null);
      }

      if (!message) {
        setError('message', CONTACT.errors.message);
        valid = false;
      } else {
        setError('message', null);
      }

      if (!valid) {
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      const endpoint = form.dataset.endpoint;

      /* No endpoint configured yet. The send failure state already carries the
         address, so the visitor still has a route. */
      if (!endpoint) {
        showStatus(CONTACT.errors.send, 'fail');
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('.submit');
      if (button) button.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error(String(response.status));

        form.reset();
        showStatus(CONTACT.success, 'ok');
      } catch {
        showStatus(CONTACT.errors.send, 'fail');
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-page {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding-block: var(--s-8) var(--s-10);
  }

  .body { color: var(--muted); }

  /*
    The 560px measure belongs to the fields, not to the form. Capping the form
    capped the send row with it, and the button, the label and the two routes
    do not fit in 560px, so the routes wrapped to a second line.
  */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    margin-top: var(--s-4);
  }

  .field { max-width: 560px; }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }


  .field label { color: var(--faint); }

  .field input,
  .field textarea {
    width: 100%;
    padding: var(--s-3);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.6;
  }

  .field textarea { resize: vertical; }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--faint);
  }

  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--crit);
  }

  .error { color: var(--crit); }

  /* Off screen rather than display:none, so a bot still fills it. */
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /*
    The send button and the direct routes, one row. It wraps to a column under
    560px, where the form is already full width and a row would crush both.
  */
  .send-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-2);
  }

  /* The only filled element on the site. 02 section 6. */
  .submit {
    min-height: 44px;
    padding: var(--s-3) var(--s-5);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-body);
    font-size: var(--t-body);
    transition: opacity var(--dur-fast) var(--ease);
  }

  .submit:hover { opacity: 0.88; }
  .submit:disabled { opacity: 0.5; cursor: not-allowed; }

  .or { color: var(--faint); }

  .fallbacks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /*
    Each route in its own container: the same 1px border, --r and --surface as
    every other card on the site, sized to match the send button's height so
    the three read as one row. Not filled, because only the submit is.
  */
  .fallback {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r);
    background: var(--surface);
    color: var(--ink);
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .fallback:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-1);
  }

  /* The send result, below the row rather than beside it. */
  .form-status { color: var(--ink); }
  .form-status[data-kind='fail'] { color: var(--crit); }
</style>
