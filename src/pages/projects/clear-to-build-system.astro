---
/* Case 02. Bespoke figures: the data pipeline (Fig 2.1), the operating table
   (Fig 2.2), and the confidence ladder, each from the source document's own
   descriptions. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseShell from '../../components/projects/CaseShell.astro';
import SectionRail from '../../components/projects/SectionRail.astro';
import AuthoritySplit from '../../components/projects/AuthoritySplit.astro';
import Figure from '../../components/projects/Figure.astro';
import DataPipeline from '../../components/projects/figures/DataPipeline.astro';
import OperatingTable from '../../components/projects/figures/OperatingTable.astro';
import ConfidenceLadder from '../../components/projects/figures/ConfidenceLadder.astro';
import { CASE_02 as c } from '../../data/cases/clear-to-build-system';
import '../../styles/case.css';
---

<BaseLayout title={`${c.title} | Jackson Barker`} description={c.meta}>
  <CaseShell case={c}>
    <SectionRail number={c.context.number} label={c.context.label} title={c.context.title}>
      {c.context.body.map((p) => <p class="case-p">{p}</p>)}

      <Figure
        number="Fig. 2.1"
        finding="Seven fragmented feeds join into one part level readiness picture; the value sits in the join."
        label="Data flow from seven supply feeds through SAP, Redshift, Excel with VBA and Tableau into part level readiness"
      >
        <DataPipeline />
      </Figure>
    </SectionRail>

    <SectionRail number={c.constraints.number} label={c.constraints.label} title={c.constraints.title}>
      <ol class="case-terms">
        {c.constraints.items.map((i) => <li><strong>{i.term}</strong><span>{i.body}</span></li>)}
      </ol>
    </SectionRail>

    <SectionRail number={c.authority.number} label={c.authority.label} title={c.authority.title}>
      {c.authority.body.map((p) => <p class="case-p">{p}</p>)}
      <AuthoritySplit owned={c.authority.owned} notOwned={c.authority.notOwned} />
    </SectionRail>

    <SectionRail number={c.build.number} label={c.build.label} title={c.build.title}>
      <ul class="stack-layers">
        {
          c.build.layers.map((l) => (
            <li>
              <span class="layer-tag t-label">{l.tag}</span>
              <span class="layer-body">
                <strong>{l.name}</strong>
                <span>{l.body}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="case-subhead t-label">{c.build.logicLabel}</h3>
      <ol class="case-terms">
        {c.build.logic.map((i) => <li><strong>{i.term}</strong><span>{i.body}</span></li>)}
      </ol>

      <Figure
        number="Fig. 2.2"
        finding="Coverage shows to runout; an ETA landing after runout is a line down risk."
        label="Illustrative operating view with part, status, inventory positions, build rate, ETA, runout and mitigation"
        provenance="Part identifiers, values and supplier labels are fabricated for illustration."
      >
        <OperatingTable />
      </Figure>
    </SectionRail>

    <SectionRail number="" label={c.confidence.label} title={c.confidence.title}>
      <p class="case-p">{c.confidence.body}</p>
      <ConfidenceLadder tiers={c.confidence.tiers} />
    </SectionRail>

    <SectionRail number={c.result.number} label={c.result.label} title={c.result.title}>
      {c.result.body.map((p) => <p class="case-p">{p}</p>)}
      <div class="case-block">
        <ul class="case-list">{c.result.items.map((i) => <li class="t-data">{i}</li>)}</ul>
      </div>
      <p class="case-note t-small">{c.note}</p>
    </SectionRail>
  </CaseShell>
</BaseLayout>

<style>
  .stack-layers {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    max-width: 68ch;
  }

  .stack-layers li {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    background: var(--surface-2);
  }

  .layer-tag { color: var(--cs-tint, var(--ink)); }

  .layer-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .layer-body strong { font-size: var(--t-body); color: var(--ink); }
  .layer-body span { font-size: var(--t-small); line-height: 1.6; color: var(--muted); }
</style>
