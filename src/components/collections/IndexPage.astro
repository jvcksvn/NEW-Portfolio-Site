---
/*
  One index template, three instances. 01 section 4.

  Version 2: the filter row is gone entirely, along with the component. The
  cards arrive through the slot as a four across grid, two at 768, one at 480,
  per 02 section 6.
*/
interface Props {
  h1: string;
  standfirst: string;
}

const { h1, standfirst } = Astro.props;
---

<section class="shell index-page">
  <h1 class="t-display">{h1}</h1>
  <p class="t-lede standfirst reading">{standfirst}</p>

  <div class="grid">
    <slot />
  </div>
</section>

<style>
  .index-page {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding-block: var(--s-8) var(--s-10);
  }

  .standfirst { color: var(--muted); }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    margin-top: var(--s-4);
  }

  @media (min-width: 480px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gutter);
    }
  }
</style>
