---
/*
  Inline SVG icons. 02-design-system.md section 9: no icon font, icons are
  inline SVG from one sprite. Every icon is decorative and aria-hidden; the
  element that carries it always carries its own text or aria-label.
*/

interface Props {
  name: 'arrow-right' | 'arrow-down' | 'menu' | 'close';
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <><line x1="2" y1="8" x2="13" y2="8" /><polyline points="8.5,3.5 13,8 8.5,12.5" /></>}
  {name === 'arrow-down' && <><line x1="8" y1="2" x2="8" y2="13" /><polyline points="3.5,8.5 8,13 12.5,8.5" /></>}
  {name === 'menu' && <><line x1="1.5" y1="4.5" x2="14.5" y2="4.5" /><line x1="1.5" y1="11.5" x2="14.5" y2="11.5" /></>}
  {name === 'close' && <><line x1="3" y1="3" x2="13" y2="13" /><line x1="13" y1="3" x2="3" y2="13" /></>}
</svg>
