---
/*
  02 section 6, "Toggle".

  Two options in a bordered container, --r-sm, the active one filled --ink with
  --bg text, the inactive transparent with --muted text. role="tablist", arrow
  key navigable. Used once, on the landing, to switch the Writing section
  between Essays and Analysis.

  Both panels render in the HTML and the inactive one is hidden, so switching
  moves nothing and costs no request. Their images are lazy either way.
*/
interface Props {
  id: string;
  options: ReadonlyArray<{ value: string; label: string }>;
  label: string;
}

const { id, options, label } = Astro.props;
---

<div class="toggle" role="tablist" aria-label={label} data-toggle={id}>
  {
    options.map((option, i) => (
      <button
        class={`option t-label${i === 0 ? ' is-active' : ''}`}
        type="button"
        role="tab"
        id={`${id}-tab-${option.value}`}
        aria-controls={`${id}-panel-${option.value}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-value={option.value}
      >
        {option.label}
      </button>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-toggle]')) {
    const id = root.dataset.toggle;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const select = (next: HTMLButtonElement, focus = true) => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;

        const panel = document.getElementById(`${id}-panel-${tab.dataset.value}`);
        if (panel) panel.hidden = !on;
      }
      if (focus) next.focus();
    };

    root.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab, false);
    });

    root.addEventListener('keydown', (event) => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1) return;

      const keys: Record<string, number> = {
        ArrowRight: index + 1,
        ArrowLeft: index - 1,
        Home: 0,
        End: tabs.length - 1,
      };

      const target = keys[event.key];
      if (target === undefined) return;

      event.preventDefault();
      select(tabs[Math.max(0, Math.min(tabs.length - 1, target))]);
    });
  }
</script>

<style>
  .toggle {
    display: inline-flex;
    padding: 2px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
  }

  .option {
    min-height: 36px;
    padding: 0 var(--s-4);
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--muted);
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .option:hover { color: var(--ink); }

  .option.is-active {
    background: var(--ink);
    color: var(--bg);
  }
</style>
