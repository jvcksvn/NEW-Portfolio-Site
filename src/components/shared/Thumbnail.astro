---
/*
  One processed image with explicit intrinsic dimensions.

  Astro's Image emits width and height from the source metadata, which is what
  holds CLS at zero: the box is reserved before the bytes arrive. 11 requires a
  responsive set, modern formats, and lazy loading below the fold.

  Where no image exists for a slug the caller passes null and renders nothing.
  11: no placeholder image is ever generated.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | null;
  alt: string;
  /** Rendered width in CSS pixels at the largest breakpoint it is used. */
  width: number;
  /** Above the fold images load eagerly; everything else lazy loads. */
  eager?: boolean;
  class?: string;
  sizes?: string;
}

const { src, alt, width, eager = false, class: className = '', sizes } = Astro.props;
---

{
  src && (
    <Image
      src={src}
      alt={alt}
      widths={[width, width * 2]}
      sizes={sizes ?? `${width}px`}
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={className}
    />
  )
}
