---
/*
  02-design-system.md section 6, "Stat row".
  Divided grid, 1px dividers, display figure over a monospaced label. Figures are
  tabular. Used in every case hero and in results.
*/
interface Props {
  stats: ReadonlyArray<{ value: string; label: string }>;
}
const { stats } = Astro.props;
---

<div class="stat-row">
  {
    stats.map((stat) => (
      <div class="stat-cell">
        <strong class="t-stat">{stat.value}</strong>
        <span class="t-label">{stat.label}</span>
      </div>
    ))
  }
</div>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .stat-cell {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-4);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stat-cell strong {
    color: var(--cs-tint, var(--ink));
    font-variant-numeric: tabular-nums;
  }

  .stat-cell span {
    color: var(--faint);
  }

  @media (min-width: 768px) {
    .stat-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
